{
  "name": "proofkeeping",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @pk/web dev",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/db-migrate.ts",
    "db:check": "drizzle-kit check",
    "shards:usage": "node scripts/shard-usage.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p packages/db/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json && tsc --noEmit -p tests/tenant-isolation/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:isolation": "vitest run tests/tenant-isolation",
    "test:e2e": "node scripts/e2e.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@eslint/js": "^9.15.0",
    "@pk/config": "workspace:*",
    "@pk/db": "workspace:*",
    "@types/node": "^22.9.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.0",
    "smol-toml": "^1.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.15.0",
    "vitest": "^3.0.0"
  }
}
