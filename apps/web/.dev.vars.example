# ローカル開発用の secret のひな形。
#
#   cp apps/web/.dev.vars.example apps/web/.dev.vars
#
# .dev.vars は .gitignore 済み。実値をこのファイルに書き戻さないこと。
# 本番・staging・preview へは wrangler.toml ではなく `wrangler secret put` で入れる。
# 手順は docs/tasks/P0-02.md の作業ログを参照。

# セッション ID の署名鍵。32 バイト以上のランダム文字列。
SESSION_SECRET="dev-only-session-secret-change-me"

# Resend の API キー。ローカルではメールを実送信しないためダミーでよい。
# **移行中のみ残している**（P5-21。Lark SMTP へ切替済み。削除は別途判断）。
RESEND_API_KEY="dev-only-resend-key"

# Lark Mail の SMTP authorization password（P5-21 / DECISIONS #248）。
# **空のままにしておくこと。** 空ならローカルでは 1 通も送らない
# （`canSendMail()` が false を返す）。実値をこのファイルに書かない。
SMTP_PASSWORD=""

# SMTP の疎通確認（POST /api/v1/dev/smtp-probe）を開ける鍵。
# **空なら 404 のまま。** staging へは workflow が実行のたびに作って登録し、
# 終わったら消す（.github/workflows/smtp-probe.yml）。
SMTP_PROBE_TOKEN=""

# CREDENTIALS KV に置く外部連携の資格情報を暗号化する鍵（security.md §7）。
CREDENTIAL_ENCRYPTION_KEY="dev-only-credential-encryption-key"

# 運営担当者の TOTP secret の暗号化鍵（PF-17）。base64url の 32 バイト。
# この値は ASCII `dev-only-2fa-totp-key-32-bytes!!` の base64url（ローカル専用）。
# staging / production へは `openssl rand -base64 32 | tr '+/' '-_' | tr -d '='` で
# 生成し、`wrangler secret put TWO_FACTOR_ENCRYPTION_KEY --env <env>` で入れる。
TWO_FACTOR_ENCRYPTION_KEY="ZGV2LW9ubHktMmZhLXRvdHAta2V5LTMyLWJ5dGVzISE"

# Sentry の DSN。空でよい（採用可否は PK-SPEC-P0 §20 で未決）。
SENTRY_DSN=""

# staging でシード投入（POST /api/v1/dev/seed）を許すための鍵。
# **ローカルでは不要**（local は鍵を見ずに受ける）。
# staging へは `wrangler secret put STAGING_SEED_TOKEN --env staging` で入れる。
# 置かなければ staging でも 404 のまま。production / preview は常に 404。
STAGING_SEED_TOKEN=""

# 運営担当者の初期開通（PF-16 / POST /api/v1/platform/bootstrap）を開ける管理鍵。
# **ローカルで開通の流れを通したいときだけ置く。** 空なら 404 のまま。
# staging / production へは workflow（.github/workflows/platform-bootstrap.yml）が
# 実行のたびに作って登録し、**終わったら消す。** 手で置いた場合も、
# 開通を確かめたら消すこと（docs/runbook/platform-bootstrap.md §6）。
PLATFORM_BOOTSTRAP_TOKEN=""
